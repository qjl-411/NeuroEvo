NEUROEVO_ENVIRONMENT=development
NEUROEVO_CORS_ORIGINS=http://localhost:5173
NEUROEVO_LOG_LEVEL=INFO

# Frozen production DMSA-Net checkpoint. Keep the .pth outside Git.
# NEUROEVO_MODEL_CHECKPOINT=/absolute/path/to/model_artifacts/final_model_epoch126.pth
# auto chooses CUDA when available and falls back to CPU.
NEUROEVO_MODEL_DEVICE=auto

# Real five-fold aligned-epoch performance curve.
# NEUROEVO_MODEL_METRICS=/absolute/path/to/model_artifacts/cv_aligned_epoch_mean.csv

# Single-file upload ceiling. JPG/JPEG/PNG are currently enabled; DICOM is not.
NEUROEVO_MAX_UPLOAD_BYTES=524288000

NEUROEVO_LITERATURE_DATABASE=data/neuroevo_papers.db
NEUROEVO_OPENALEX_API_KEY=your_openalex_api_key_here
NEUROEVO_LITERATURE_PDF_DIRECTORY=data/pdfs
