# Phase 4 production model integration
# Use absolute paths on the final machine whenever possible.
NEUROEVO_MODEL_CHECKPOINT=/absolute/path/to/NeuroEvo-AD/model_artifacts/final_model_epoch126.pth
NEUROEVO_MODEL_DEVICE=auto

# This is the 5-fold aligned-epoch mean curve, not fabricated per-patient data.
NEUROEVO_MODEL_METRICS=/absolute/path/to/NeuroEvo-AD/model_artifacts/cv_aligned_epoch_mean.csv

# Optional serving defaults used by scripts/serve_verified.py
NEUROEVO_HOST=0.0.0.0
NEUROEVO_PORT=8000
