# Example Nginx virtual host for NeuroEvo-AD.
# Replace YOUR_DOMAIN and /srv/neuroevo/apps/web/dist before enabling.
server {
    listen 80;
    server_name YOUR_DOMAIN;

    root /srv/neuroevo/apps/web/dist;
    index index.html;

    client_max_body_size 500m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8000/api/v1/health;
    }

    location = /readyz {
        proxy_pass http://127.0.0.1:8000/api/v1/readiness;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
