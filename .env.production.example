# Copy to apps/api/.env on the server or load it through systemd EnvironmentFile.
NEUROEVO_ENVIRONMENT=production
NEUROEVO_CORS_ORIGINS=https://YOUR_DOMAIN
NEUROEVO_LOG_LEVEL=INFO
NEUROEVO_MODEL_CHECKPOINT=/srv/neuroevo/model_artifacts/final_model_epoch126.pth
NEUROEVO_MODEL_DEVICE=cuda:0
NEUROEVO_MODEL_METRICS=/srv/neuroevo/model_artifacts/cv_aligned_epoch_mean.csv
NEUROEVO_MAX_UPLOAD_BYTES=524288000
NEUROEVO_LITERATURE_DATABASE=/srv/neuroevo/apps/api/data/neuroevo_papers.db
NEUROEVO_LITERATURE_PDF_DIRECTORY=/srv/neuroevo/apps/api/data/pdfs
# NEUROEVO_OPENALEX_API_KEY=
